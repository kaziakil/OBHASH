# ==============================================================================
# OBHASH Environment Configuration Template
# Phase 1: Foundation & Infrastructure
# ==============================================================================
# IMPORTANT: Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any secrets into version control.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Public credentials (accessible on browser and server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Privileged Server-Only credentials (NEVER prefix with NEXT_PUBLIC_)
# Used exclusively for administrative server-side operations, seed jobs, and migrations
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# ------------------------------------------------------------------------------
# AI Provider Configuration (Server-Side Only)
# ------------------------------------------------------------------------------
# Active AI provider: "gemini" | "openai"
AI_PROVIDER=gemini

# Primary model name
# For Gemini: gemini-2.5-flash, gemini-2.5-pro, etc.
# For OpenAI: gpt-4o, gpt-4o-mini, etc.
AI_MODEL_NAME=gemini-2.5-flash

# Maximum request timeout in milliseconds (default: 30000 = 30 seconds)
AI_TIMEOUT_MS=30000

# Provider API Keys (NEVER expose to client)
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
